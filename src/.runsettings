<?xml version="1.0" encoding="utf-8"?>
<!-- This .runsettings file is for local development use with Visual Studio Test Explorer.
     CI uses dotnet-coverage directly for coverage collection. -->
<RunSettings>
  <!-- xUnit v3 configuration -->
  <RunConfiguration>
    <MaxCpuCount>0</MaxCpuCount>
  </RunConfiguration>

  <!-- Code coverage via dotnet-coverage (used in CI) -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <ModulePaths>
            <Exclude>
              <ModulePath>.*\.Tests\.dll</ModulePath>
              <ModulePath>.*\.Benchmarks\.dll</ModulePath>
              <ModulePath>xunit\.execution\.*</ModulePath>
              <ModulePath>xunit\.v3\.*</ModulePath>
              <ModulePath>NSubstitute\.*</ModulePath>
            </Exclude>
          </ModulePaths>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
