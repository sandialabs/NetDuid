<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      "local-NetDuid" points at the feed/ folder that run-smoke-tests.{sh,ps1} creates
      by packing the library before running the consumer.  The path is relative to
      this nuget.config file (i.e. smoketests/NetDuid.SmokeTests/feed/).
    -->
    <add key="local-NetDuid" value="./feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
